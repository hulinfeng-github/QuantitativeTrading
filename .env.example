# =================================================================
# 量化交易系统可选环境变量配置
# 系统优先读取 storage/user_config.json（可通过 Web 界面直接配置）
# 也支持直接通过系统环境变量或此 .env 文件配置
# =================================================================

# 钉钉机器人推送配置（可选）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx
# DINGTALK_SECRET=SECxxxx

# 微信推送配置（可选，provider 支持 pushplus / serverchan / wecom）
# WECHAT_PROVIDER=pushplus
# WECHAT_TOKEN=your_pushplus_token_here

# Web 服务端口配置
# WEB_PORT=8088
# WEB_HOST=127.0.0.1
